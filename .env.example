# Turso (SQLite serverless) — tạo miễn phí tại https://turso.tech
# Xem hướng dẫn tạo DB trong README.md
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Tài khoản đăng nhập Dashboard (dashboard.html)
DASHBOARD_USER=admin
DASHBOARD_PASS=1

# Chuỗi bí mật để ký cookie session của dashboard — sinh 1 chuỗi ngẫu nhiên dài, ví dụ:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=generate-a-long-random-string-here

# Bật bypass đăng nhập dashboard bằng mật khẩu "0" (chỉ dùng ở local/UAT).
# KHÔNG set true trên Vercel Production — code đã chặn cứng dù có set nhầm,
# nhưng để chuẩn thì chỉ khai báo biến này ở local .env hoặc Preview env của Vercel.
IS_UAT=true
